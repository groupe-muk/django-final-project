# Local Django settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-me-with-a-local-secret
# Optional locally. Set the pooled Neon URL in Render for deployment.
DATABASE_URL=
# Add complete HTTPS origins, separated by commas, when using a custom domain.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only after confirming every request uses HTTPS.
DJANGO_SECURE_HSTS_SECONDS=0

# Required only for audio transcription
GROQ_API_KEY=

# Optional MyMemory translation settings
MYMEMORY_BASE_URL=https://api.mymemory.translated.net
MYMEMORY_CONTACT_EMAIL=
MYMEMORY_API_KEY=
MYMEMORY_TIMEOUT_SECONDS=10

# Optional: powers IP-based UI language auto-detection on first visit
# (see core/utils.py, core/views.py). Get a free token at https://ipinfo.io.
# Leave empty to use ipinfo's unauthenticated (rate-limited) tier, or the
# feature silently no-ops and the site defaults to English.
IPINFO_TOKEN=
IPINFO_TIMEOUT_SECONDS=3
